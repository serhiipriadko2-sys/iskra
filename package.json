{
  "name": "iskra-monorepo",
  "private": true,
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm run build:runtime && pnpm -r --if-present typecheck",
    "build:runtime": "pnpm --dir runtime build",
    "verify": "cd runtime && npm run build && cd .. && npm run check:shard-registry && npm run check:sensitive-status && npm run typecheck && pnpm test && npx tsx tools/verify_ledger.ts",
    "ledger:update": "npx tsx tools/update_ledger.ts",
    "check:imports": "python tools/check_no_src_imports.py",
    "check:sensitive-status": "python tools/check_no_sensitive_status_dumps.py",
    "sot40:build": "python tools/build_sot40_artifact.py --out-dir dist/sot40",
    "sot40:verify": "python tools/verify_sot40_receipt.py --receipt dist/sot40/receipt.json",
    "ingest:phase1": "python tools/build_phase1_classification.py",
    "check:adr-gate": "python tools/check_core_adr_gate.py",
    "check:shard-registry": "python tools/check_shard_registry_consistency.py",
    "import:shard1": "python tools/import_phase1_shard1.py",
    "import:shard2": "python tools/import_phase1_shard2.py",
    "import:shard3": "python tools/import_phase1_shard3.py",
    "import:shard": "python tools/import_phase1_shard.py"
  },
  "devDependencies": {
    "tsx": "^4.7.1",
    "typescript": "^5.0.0",
    "vitest": "^2.0.0"
  }
}
