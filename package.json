{
  "name": "iskra-monorepo",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm run build:runtime && pnpm -r --if-present typecheck",
    "build:runtime": "pnpm run prepare:legacy-runtime && cd runtime && npm run build",
    "verify": "pnpm run build:runtime && npm run check:shard-registry && npm run check:sensitive-status && npm run typecheck && pnpm test && npm run check:release-manifest && npx tsx tools/verify_ledger.ts",
    "check:skill-registry": "node tools/run_python.mjs tools/validate_skill_integrity.py docs/skills/registry-v1.json --registry-only --strict",
    "test:skill-registry": "node tools/run_python.mjs tools/test_validate_skill_integrity.py",
    "ledger:update": "npx tsx tools/update_ledger.ts",
    "check:supabase-voice-metrics-contract": "npx tsx tools/verify_supabase_voice_metrics_contract.ts",
    "check:supabase-voice-metrics-contract:repo": "npx tsx tools/verify_supabase_voice_metrics_contract.ts --repo-only",
    "check:supabase-graph-contract": "npx tsx tools/verify_supabase_graph_contract.ts",
    "check:supabase-graph-contract:repo": "npx tsx tools/verify_supabase_graph_contract.ts --repo-only",
    "check:iskra-metrics-parity": "pnpm --filter @iskra/math test -- edgeMetricsParity.test.ts",
    "check:no-graphql-clients": "npx tsx tools/check_no_graphql_clients.ts",
    "check:imports": "node tools/run_python.mjs tools/check_no_src_imports.py",
    "check:sensitive-status": "node tools/run_python.mjs tools/check_no_sensitive_status_dumps.py",
    "supabase:start": "pnpm exec supabase start",
    "supabase:stop": "pnpm exec supabase stop",
    "supabase:status": "pnpm exec supabase status",
    "supabase:reset": "pnpm exec supabase db reset",
    "supabase:logs": "pnpm exec supabase logs",
    "supabase:migration:new": "pnpm exec supabase migration new",
    "sot40:build": "node tools/run_python.mjs tools/build_sot40_artifact.py --out-dir dist/sot40",
    "sot40:verify": "node tools/run_python.mjs tools/verify_sot40_receipt.py --receipt dist/sot40/receipt.json",
    "ingest:phase1": "node tools/run_python.mjs tools/build_phase1_classification.py",
    "check:adr-gate": "node tools/run_python.mjs tools/check_core_adr_gate.py",
    "check:shard-registry": "node tools/run_python.mjs tools/check_shard_registry_consistency.py",
    "import:shard1": "node tools/run_python.mjs tools/import_phase1_shard1.py",
    "import:shard2": "node tools/run_python.mjs tools/import_phase1_shard2.py",
    "import:shard3": "node tools/run_python.mjs tools/import_phase1_shard3.py",
    "import:shard": "node tools/run_python.mjs tools/import_phase1_shard.py",
    "prepare:legacy-runtime": "node tools/ensure_runtime_deps.mjs",
    "check:release-manifest": "node tools/run_python.mjs tools/test_release_manifest.py"
  },
  "devDependencies": {
    "jose": "6.1.0",
    "supabase": "^2.109.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
