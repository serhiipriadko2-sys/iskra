{
  "name": "iskra-monorepo",
  "private": true,
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r run typecheck",
    "verify": "cd runtime && npm run build && cd .. && npm run check:shard-registry && npm run typecheck && pnpm test && python tools/verify_ledger.py",
    "ingest:phase1": "python tools/build_phase1_classification.py",
    "check:adr-gate": "python tools/check_core_adr_gate.py",
    "check:shard-registry": "python tools/check_shard_registry_consistency.py",
    "import:shard1": "python tools/import_phase1_shard1.py",
    "import:shard2": "python tools/import_phase1_shard2.py",
    "import:shard3": "python tools/import_phase1_shard3.py",
    "import:shard": "python tools/import_phase1_shard.py"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "vitest": "^2.0.0"
  }
}
