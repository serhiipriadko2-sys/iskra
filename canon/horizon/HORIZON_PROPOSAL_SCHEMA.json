{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Horizon Proposal v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "trigger",
    "mode",
    "base_epoch",
    "mutations",
    "rollback_hint",
    "semantic_label"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "trigger": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": [
        "dry_run"
      ]
    },
    "base_epoch": {
      "type": "integer",
      "minimum": 0
    },
    "mutations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "op",
          "reason"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "op": {
            "type": "string",
            "minLength": 1
          },
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "ritual": {
      "type": "object",
      "required": [
        "trigger_ritual",
        "text"
      ],
      "properties": {
        "trigger_ritual": {
          "type": "boolean"
        },
        "text": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "rollback_hint": {
      "type": "string",
      "minLength": 1
    },
    "semantic_label": {
      "enum": [
        "FORM_PASS",
        "FORM_PASS_NEEDS_HUMAN_REVIEW",
        "SHIFT_BLOCKED"
      ]
    }
  }
}
