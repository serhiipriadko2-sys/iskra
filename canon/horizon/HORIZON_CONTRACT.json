{
  "meta": {
    "name": "Iskra Horizon Contract",
    "version": "0.2-darkrun",
    "created_utc": "2026-01-24T10:08:02Z",
    "notes": [
      "Contract for Horizon Weaver (darkrun-first).",
      "No disk writes before validate(pass).",
      "User symbols are not triggers; meta_permission is required.",
      "Full-density guard for canonical 1–8 (blocks accidental compression)."
    ],
    "updated_utc": "2026-01-24T14:41:42Z"
  },
  "trigger": {
    "meta_permission_required": true,
    "user_symbol_is_not_trigger": true,
    "allowed_modes": [
      "darkrun",
      "maintenance"
    ]
  },
  "limits": {
    "max_edges_per_activation": 3,
    "max_direction_spawns_per_session": 1,
    "max_meta_activations_per_session": 3,
    "max_dissonance_rituals_per_session": 2
  },
  "symbol_generation": {
    "pool": [
