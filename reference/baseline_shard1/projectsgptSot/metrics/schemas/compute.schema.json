{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Iskra Metrics Compute v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "metrics",
    "derived",
    "gate",
    "findings",
    "trace",
    "invariants_check"
  ],
  "properties": {
    "profile": {
      "type": "string",
      "enum": [
        "canon",
        "lab"
      ]
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clarity",
        "trust",
        "drift",
        "echo_clearance",
        "protocol",
        "trace_count"
      ],
      "properties": {
        "clarity": {
          "type": "number"
        },
        "trust": {
          "type": "number"
        },
        "drift": {
          "type": "number"
        },
        "echo_clearance": {
          "type": "number"
        },
        "protocol": {
          "type": "number"
        },
        "trace_count": {
          "type": "integer"
        }
      }
    },
    "derived": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trace_factor",
        "alive_index",
        "eval_score"
      ],
      "properties": {
        "trace_factor": {
          "type": "number"
        },
        "alive_index": {
          "type": "number"
        },
        "eval_score": {
          "type": "number"
        },
        "baseline_alive_index": {
          "type": [
            "number",
            "null"
          ]
        },
        "alive_delta": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "max_findings",
        "findings_count"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "PASS",
            "WARN",
            "FAIL"
          ]
        },
        "max_findings": {
          "type": "integer",
          "minimum": 0
        },
        "findings_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "severity",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "INFO",
              "WARN",
              "FAIL"
            ]
          },
          "message": {
            "type": "string"
          }
        }
      }
    },
    "trace": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "step",
          "rule",
          "inputs",
          "output"
        ],
        "properties": {
          "step": {
            "type": "string"
          },
          "rule": {
            "type": "string"
          },
          "inputs": {
            "type": "object"
          },
          "output": {
            "type": "object"
          }
        }
      }
    },
    "invariants_check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ok",
        "errors"
      ],
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
