# Enforce LF line endings for all text files in the Builder upload set.
# This keeps MANIFEST.sha256 byte-consistent across Windows/macOS/Linux.
* text=auto eol=lf
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.sha256 text eol=lf
*.txt text eol=lf
*.sh text eol=lf
*.ps1 text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# Treat binary files as binary so Git never converts their line endings.
*.png binary
*.jpg binary
*.jpeg binary
*.svg binary
*.ico binary
*.zip binary
