{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Jules Skill Metrics",
  "description": "Schema for storing feedback loop data for Jules Skills",
  "type": "object",
  "properties": {
    "skill_id": {
      "type": "string",
      "description": "The unique identifier of the skill (e.g., unit_test_refactor)"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "execution_context": {
      "type": "object",
      "properties": {
        "repo": { "type": "string" },
        "pr_id": { "type": "integer" },
        "trigger": { "type": "string" }
      }
    },
    "outcome": {
      "type": "string",
      "enum": ["success", "failure", "partial", "aborted"]
    },
    "metrics": {
      "type": "object",
      "properties": {
        "coverage_delta": { "type": "number" },
        "tests_passed": { "type": "integer" },
        "tests_failed": { "type": "integer" },
        "execution_time_ms": { "type": "integer" },
        "cost_tokens": { "type": "integer" }
      }
    },
    "feedback": {
      "type": "object",
      "properties": {
        "human_rating": { "type": "integer", "minimum": 1, "maximum": 5 },
        "comments": { "type": "string" },
        "accepted_changes_ratio": { "type": "number" }
      }
    }
  },
  "required": ["skill_id", "timestamp", "outcome"]
}
