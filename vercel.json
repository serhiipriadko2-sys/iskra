{
  "version": 2,
  "buildCommand": "npm --prefix runtime run build && pnpm --filter iskra-space build",
  "outputDirectory": "runtime/iskraSpace/dist",
  "framework": "vite",
  "installCommand": "corepack enable && pnpm install --frozen-lockfile && npm --prefix runtime ci",
  "devCommand": "corepack enable && pnpm --filter iskra-space dev",
  "regions": ["iad1"],
  "env": {
    "NODE_VERSION": "20"
  },
  "build": {
    "env": {
      "NODE_VERSION": "20"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer-when-downgrade"
        }
      ]
    },
    {
      "source": "/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
