# Supabase Edge Function secrets template
# Set secrets with: pnpm exec supabase secrets set --env-file .env
# For local development: pnpm exec supabase secrets set --env-file .env --local
# Do NOT commit real values.

# Canonical IskraSpace AI provider key (server-side only)
GEMINI_API_KEY=your_gemini_api_key_here

# AI proxy / Edge gateway security
AI_PROXY_ALLOWED_ORIGINS=https://your-app.example.com,https://preview.example.com
AI_EDGE_ENV=production
AI_EDGE_ALLOW_DEV_WILDCARD=false
# Verified on a Supabase preview branch; x-forwarded-for was client-spoofable.
AI_EDGE_INGRESS_IP_HEADER=cf-connecting-ip
AI_RATE_LIMIT_IP_HMAC_SECRET=replace_with_random_server_only_secret
AI_EDGE_TEST_MODE=false

# embed function best-effort rate limiting
EMBED_RL_WINDOW_MS=60000
EMBED_RL_MAX=60

# kain repair function — origin allow-list + rate limiting
# Never set to '*' in production (that is a dev-only opt-in).
KAIN_ALLOWED_ORIGINS=https://your-app.example.com,https://preview.example.com
KAIN_RL_WINDOW_MS=60000
KAIN_RL_MAX=60

# iskra-agent proxy (Workspace Agent) — REQUIRED before public deploy.
# This function forwards to a BILLED upstream agent API, so origin allow-list,
# JWT verification and rate limiting are mandatory. Never set origins to '*' in prod.
ISKRA_AGENT_ALLOWED_ORIGINS=https://your-app.example.com,https://preview.example.com
# AGENT_ID and AGENT_ACCESS_TOKEN are provisioned server-side (do NOT commit real values).
AGENT_ID=your_workspace_agent_id_here
AGENT_ACCESS_TOKEN=your_workspace_agent_access_token_here

# iskra-memory-gateway — server-to-server only (ChatGPT Projects backend), not a
# browser-facing function. Identity is verified by checking the caller's static
# project JWT signature against this legacy HS256 secret (Project Settings > API
# > JWT Secret), then requiring role == "service_role". Never commit the real value.
SUPABASE_JWT_SECRET=your_supabase_project_jwt_secret_here
SUPABASE_DB_POOLER_URL=your_supabase_pooler_connection_string_here
ISKRA_GATEWAY_ALLOWED_ORIGINS=https://chatgpt.com
