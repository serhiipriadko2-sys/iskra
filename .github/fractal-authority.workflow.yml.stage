name: Fractal authority

on:
  push:
    paths:
      - 'packages/math/**'
      - 'packages/engine/**'
      - 'runtime/src/**'
      - 'supabase/functions/_shared/iskra-metrics/**'
      - 'governance/adr_20260729_packages_math_authoritative_api.md'
      - 'governance/evidence/metrics/fractal-authority-consumer-inventory-2026-07-30.json'
      - 'governance/registries/fractal-compatibility-v1.json'
      - 'tools/*fractal-authority*'
      - '.github/workflows/fractal_authority.yml'
  pull_request:
    paths:
      - 'packages/math/**'
      - 'packages/engine/**'
      - 'runtime/src/**'
      - 'supabase/functions/_shared/iskra-metrics/**'
      - 'governance/adr_20260729_packages_math_authoritative_api.md'
      - 'governance/evidence/metrics/fractal-authority-consumer-inventory-2026-07-30.json'
      - 'governance/registries/fractal-compatibility-v1.json'
      - 'tools/*fractal-authority*'
      - '.github/workflows/fractal_authority.yml'

jobs:
  t1-t19:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: pnpm/action-setup@v4
      - uses: actions/setup-node@v4
        with:
          node-version: '22'
          cache: 'pnpm'
          cache-dependency-path: pnpm-lock.yaml
      - name: Install workspace dependencies
        run: pnpm install --frozen-lockfile
      - name: Verify generated mirrors and authority boundary
        run: pnpm check:fractal-authority
      - name: Run canonical math and Node/Edge parity tests
        run: pnpm --filter @iskra/math test -- fractal-authority.test.ts edgeMetricsParity.test.ts
      - name: Run engine authority-path migration tests
        run: pnpm --filter @iskra/engine test -- metricsServiceFractalAuthority.test.ts
      - name: Install and typecheck legacy runtime
        working-directory: runtime
        run: |
          npm ci --ignore-scripts
          npm run typecheck
          npm run test -- --run src/__tests__/fractalAuthority.test.ts
      - uses: denoland/setup-deno@v2
        with:
          deno-version: v2.x
      - name: Run generated Edge contract tests
        run: deno test --no-lock supabase/functions/_shared/iskra-metrics/iskra-metrics_test.ts
      - name: Verify SoT integrity
        run: npx tsx tools/verify_ledger.ts
