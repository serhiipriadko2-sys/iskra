    "@types/three": "^0.160.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@eslint/js": "^9.23.0",
    "@playwright/test": "^1.51.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.23.0",
    "eslint-plugin-react": "^7.37.4",
