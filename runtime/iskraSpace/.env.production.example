# iskraSpace Production Environment
# SECURITY: Never commit real values!

# API Keys (production keys)
VITE_SUPABASE_URL=https://production-project.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_replace_with_public_key

# Closed beta: anonymous Auth is disabled in code and is not a runtime switch.

# Runtime AI boundary (Supabase Edge only)
VITE_AI_PROVIDER=gemini
VITE_AI_EDGE_FUNCTION_SLUG=gemini
VITE_ENABLE_REMOTE_SEMANTIC_SEARCH=false
VITE_ALLOW_SENSITIVE_REMOTE_EMBEDDING=false

# Error Tracking (production project)
VITE_SENTRY_DSN=https://publickey@o123.ingest.sentry.io/123456

# Analytics (production)
VITE_POSTHOG_KEY=phc_production
VITE_POSTHOG_HOST=https://app.posthog.com

# Receipt/runtime correlation (commit SHA or release version)
VITE_APP_VERSION=unknown

# Unavailable beta capabilities are deny-by-default in config/betaCapabilities.ts.
# They intentionally have no environment-variable override.
