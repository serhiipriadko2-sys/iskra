{
  "compilerOptions": {
    "target": "ES2022",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "module": "ESNext",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "types": [
      "node",
      "react",
      "react-dom",
      "vite/client"
    ],
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowJs": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": [
        "./*"
      ],
      "@iskra/runtime": [
        "../src/index.ts"
      ],
      "@iskra/runtime/*": [
        "../src/*"
      ],
      "@iskra/math": [
        "../../packages/math/src/index.ts"
      ],
      "@iskra/math/*": [
        "../../packages/math/src/*"
      ],
      "@iskra/core": [
        "../../packages/core/src/index.ts"
      ],
      "@iskra/core/*": [
        "../../packages/core/src/*"
      ]
    },
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "exclude": [
    "node_modules",
    "iskra-spaceapp",
    "e2e",
    "playwright-report",
    "test-results",
    "supabase"
  ]
}
