# iskraSpace Environment Configuration
# Copy to .env.local and fill in your values

# =============================================================================
# REQUIRED: canonical Gemini provider key (server-side only)
# Set it in Supabase Edge Function secrets; never put it in Vite env.
# - GEMINI_API_KEY=...
#
# Edge gateway security:
# - AI_PROXY_ALLOWED_ORIGINS=https://your-app.example.com,https://preview.example.com
# - ISKRA_AGENT_ALLOWED_ORIGINS=https://your-app.example.com,https://preview.example.com
# - AI_EDGE_ENV=production
# - AI_EDGE_ALLOW_DEV_WILDCARD=false
# - AI_EDGE_INGRESS_IP_HEADER=the-single-header-injected-by-your-trusted-edge
# - AI_RATE_LIMIT_IP_HMAC_SECRET=generate-and-store-only-in-Supabase-secrets
# - AI_EDGE_TEST_MODE=false
# - Quota is enforced transactionally in Postgres: 30/member/minute,
#   10/IP-minute (HMAC digest only), and 250/member/day.
#
# KAIN repair signal function:
# - KAIN_ALLOWED_ORIGINS=https://your-app.example.com,https://preview.example.com
# - KAIN_RL_WINDOW_MS=60000
# - KAIN_RL_MAX=60
#
# iskra-agent ChatGPT Workspace Agent proxy:
# - Uses the same AI_EDGE_ENV, AI_EDGE_ALLOW_DEV_WILDCARD and
#   AI_RATE_LIMIT_IP_HMAC_SECRET boundary as gemini.
# - AGENT_ID=...
# - AGENT_ACCESS_TOKEN=...
# =============================================================================

# =============================================================================
# REQUIRED: Supabase (Backend)
# =============================================================================
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Development-only legacy compatibility. Production ignores this flag.
# VITE_ENABLE_ANONYMOUS_AUTH=false

# =============================================================================
# OPTIONAL: canonical AI gateway slug (no provider selector and no API keys)
# =============================================================================
# VITE_AI_EDGE_FUNCTION_SLUG=gemini
# Legacy aliases still supported:
# VITE_GEMINI_EDGE_FUNCTION_SLUG=gemini
# VITE_GEMINI_FUNCTION_SLUG=gemini

# =============================================================================
# OPTIONAL: Error Tracking (Sentry)
# =============================================================================
# VITE_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# =============================================================================
# OPTIONAL: Analytics (PostHog - Privacy-First)
# =============================================================================
# VITE_POSTHOG_KEY=phc_xxx
# VITE_POSTHOG_HOST=https://app.posthog.com

# =============================================================================
# OPTIONAL: Feature Flags
# =============================================================================
# VITE_ENABLE_VOICE_TRANSCRIPTION=true
# VITE_ENABLE_DUO_LINK=false
# VITE_ENABLE_TAROT=true

# =============================================================================
# OPTIONAL: Debug
# =============================================================================
# VITE_DEBUG_MODE=false
# VITE_LOG_LEVEL=info
